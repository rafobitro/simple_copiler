$number greeting[13]
greeting[0] = 'H'
greeting[1] = 'e'
greeting[2] = 'l'
greeting[3] = 'l'
greeting[4] = 'o'
greeting[5] = ' '
greeting[6] = 'W'
greeting[7] = 'o'
greeting[8] = 'r'
greeting[9] = 'l'
greeting[10] = 'd'
greeting[11] = '!'
greeting[12] = 0

#print(greeting[])

@print (str) {
   
  "
    lw $t0, str
  print_loop:
    lw $t1, 0($t0)
    beqz $t1, end_print
    move $a0, $t1
    li $v0, 11
    syscall
    addi $t0, $t0, 4
    j print_loop
  end_print:
  "

}

